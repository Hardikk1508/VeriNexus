# ---------------- LLM (required) ----------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---------------- Web evidence ----------------
# Without this, research runs on uploaded documents only.
TAVILY_API_KEY=
RESULTS_PER_QUERY=5

# ---------------- Storage ----------------
# Leave MONGODB_URI blank to run without audit-trail persistence.
MONGODB_URI=
MONGODB_DB=verinexus
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# ---------------- Models ----------------
EMBED_MODEL=all-MiniLM-L6-v2
# "llm" = Groq judges entailment (no extra download).
# "local" = in-process DeBERTa NLI (needs torch + transformers, ~500MB).
NLI_BACKEND=llm
LOCAL_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli

# ---------------- Ingestion ----------------
CHUNK_WORDS=220
CHUNK_OVERLAP=40

# ---------------- Retrieval ----------------
RRF_K=60
EVIDENCE_PER_CLAIM=5
DRAFT_CONTEXT_CHUNKS=12

# ---------------- Planning ----------------
MAX_SUB_QUESTIONS=5
MAX_REPAIR_ROUNDS=2

# ---------------- CEVS weights (see docs/ALGORITHM.md) ----------------
W_SUPPORT=0.45
W_AGREEMENT=0.25
W_AUTHORITY=0.15
W_CONTRADICTION=0.35

ENTAIL_THRESHOLD=0.60
REVIEW_THRESHOLD=0.55
BAND_VERIFIED=0.75
BAND_PARTIAL=0.55
BAND_WEAK=0.30
CONFLICT_CONTRA_MIN=0.50
CONFLICT_SUPPORT_MIN=0.50
PENALTY_CONFLICT=0.15
PENALTY_SINGLE_SOURCE=0.20

# JSON list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
