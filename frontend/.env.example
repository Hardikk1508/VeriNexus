# Only needed if you are NOT using the Vite dev proxy (see vite.config.js).
# In production set this to your Render URL, e.g. https://verinexus-api.onrender.com
VITE_API_BASE=

# Firebase web app config — public/client-safe values, from Firebase Console
# → Project Settings → General → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
